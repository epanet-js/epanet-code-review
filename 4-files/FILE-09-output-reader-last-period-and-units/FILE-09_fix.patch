FILE-09: let series reads reach the last period; match engine press units

ENR_getNodeSeries and ENR_getLinkSeries treat endPeriod as exclusive
(they return endPeriod - startPeriod values) but reject endPeriod >=
nPeriods, so the last period can never be read as a series. Accept
endPeriod == nPeriods. The ENR_PressUnits enum says 1 = metres and
2 = kPa, but the engine writes its own codes (0 psi, 1 kPa, 2 metres,
3 bar, 4 feet). Give the enum the engine's values and add bar and feet.

Apply from the root of an EPANET checkout at 83e25bb:
    git apply FILE-09_fix.patch

diff --git a/src/outfile/include/epanet_output_enums.h b/src/outfile/include/epanet_output_enums.h
index c559835..7c605d2 100644
--- a/src/outfile/include/epanet_output_enums.h
+++ b/src/outfile/include/epanet_output_enums.h
@@ -39,8 +39,10 @@ typedef enum {
 
 typedef enum {
 	ENR_PSI         = 0,
-	ENR_MTR         = 1,
-	ENR_KPA         = 2
+	ENR_KPA         = 1,
+	ENR_MTR         = 2,
+	ENR_BAR         = 3,
+	ENR_FEET        = 4
 } ENR_PressUnits;
 
 typedef enum {
diff --git a/src/outfile/src/epanet_output.c b/src/outfile/src/epanet_output.c
index 0824e6a..0b61ac2 100644
--- a/src/outfile/src/epanet_output.c
+++ b/src/outfile/src/epanet_output.c
@@ -286,8 +286,10 @@ int EXPORT_OUT_API ENR_getUnits(ENR_Handle p_handle, ENR_Units code, int* unitFl
  **  Purpose: Returns pressure or flow unit flag
  **--------------pressure unit flags----------------------------------------
  **  0 = psi
- **  1 = meters
- **  2 = kPa
+ **  1 = kPa
+ **  2 = meters
+ **  3 = bar
+ **  4 = feet
  **------------------flow unit flags----------------------------------------
  **  0 = cubic feet/second
  **  1 = gallons/minute
@@ -578,7 +580,7 @@ int EXPORT_OUT_API ENR_getNodeSeries(ENR_Handle p_handle, int nodeIndex, ENR_Nod
 
     if (p_data == NULL) return -1;
     else if (nodeIndex < 1 || nodeIndex > p_data->nodeCount) errorcode = 423;
-    else if (startPeriod < 0 || endPeriod >= p_data->nPeriods ||
+    else if (startPeriod < 0 || endPeriod > p_data->nPeriods ||
             endPeriod <= startPeriod) errorcode = 422;
     // Check memory for outValues
     else if MEMCHECK(temp = newFloatArray(length = endPeriod - startPeriod)) errorcode = 411;
@@ -614,7 +616,7 @@ int EXPORT_OUT_API ENR_getLinkSeries(ENR_Handle p_handle, int linkIndex, ENR_Lin
 
     if (p_data == NULL) return -1;
     else if (linkIndex < 1 || linkIndex > p_data->linkCount) errorcode = 423;
-    else if (startPeriod < 0 || endPeriod >= p_data->nPeriods ||
+    else if (startPeriod < 0 || endPeriod > p_data->nPeriods ||
             endPeriod <= startPeriod) errorcode = 422;
     // Check memory for outValues
     else if MEMCHECK(temp = newFloatArray(length = endPeriod - startPeriod)) errorcode = 411;
