[TITLE]
API-11: two junctions, a reservoir and two tanks, with no quality sources
Node indices: J1 = 1, J2 = 2, R1 = 3, T1 = 4, T2 = 5.

[JUNCTIONS]
;ID  Elev  Demand
 J1  0     100
 J2  0     100

[RESERVOIRS]
;ID  Head
 R1  150

[TANKS]
;ID  Elev  InitLevel  MinLevel  MaxLevel  Diameter  MinVol
 T1  100   10         0         20        50        0
 T2  100   10         0         20        50        0

[PIPES]
;ID  N1  N2  Length  Diam  Rough  Mloss  Status
 P1  R1  J1  1000    12    100    0      Open
 P2  J1  J2  1000    12    100    0      Open
 P3  T1  J1  1000    12    100    0      Open
 P4  T2  J2  1000    12    100    0      Open

[OPTIONS]
 Units     GPM
 Headloss  H-W
 Quality   Chemical mg/L

[END]
