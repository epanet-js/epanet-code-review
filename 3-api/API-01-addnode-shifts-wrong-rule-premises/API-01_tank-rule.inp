[TITLE]
API-01: a rule whose premises refer to a reservoir and a tank

[JUNCTIONS]
;ID   Elev  Demand
 J1   0     100
 J2   0     100

[RESERVOIRS]
;ID   Head
 R1   150         ; node 3, the first node after the junctions

[TANKS]
;ID  Elev  InitLevel  MinLevel  MaxLevel  Diameter  MinVol
 T1  100   10         0         20        50        0       ; node 4

[PIPES]
;ID  N1  N2  Length  Diam  Rough  Mloss  Status
 P1  R1  J1  1000    12    100    0      Open
 P2  J1  J2  1000    12    100    0      Open
 P3  J2  T1  1000    12    100    0      Open

[RULES]
RULE 1
IF RESERVOIR R1 HEAD > 100
AND TANK T1 LEVEL > 15
THEN PIPE P3 STATUS IS CLOSED

[OPTIONS]
 Units      GPM
 Headloss   H-W

[END]
