[TITLE]
API-09: five rules on pipe P2; rules 2 and 4 are malformed

[JUNCTIONS]
;ID   Elev  Demand
 J1   100   50

[RESERVOIRS]
;ID   Head
 R1   200

[TANKS]
;ID  Elev  InitLevel  MinLevel  MaxLevel  Diameter  MinVol
 T1  150   10         0         20        50        0

[PIPES]
;ID  N1  N2  Length  Diam  Rough  Mloss  Status
 P1  R1  J1  1000    12    100    0      Open
 P2  J1  T1  1000    12    100    0      Open

[RULES]
RULE R1
IF TANK T1 LEVEL > 18
THEN PIPE P2 STATUS = CLOSED

RULE R2
IF TANK T1 LEVEL < 2
THEN PIPE P2 STATUS = OPNE          ; misspelt status: error 202

RULE R3
IF TANK T1 LEVEL < 5
THEN PIPE P2 STATUS = OPEN

RULE Fill tank                      ; label with a space: error 201
IF TANK T1 LEVEL < 1
THEN PIPE P2 STATUS = OPEN

RULE R5
IF SYSTEM CLOCKTIME >= 6:00
THEN PIPE P1 STATUS = OPEN

[TIMES]
 Duration  6:00

[OPTIONS]
 Units     GPM
 Headloss  H-W

[END]
