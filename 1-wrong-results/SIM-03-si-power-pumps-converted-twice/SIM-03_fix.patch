-    pump->R = -8.814 * pr->network.Link[pump->Link].Km / pr->Ucf[POWER];
+    pump->R = -8.814 * pr->network.Link[pump->Link].Km;
     pump->N = -1.0;
     pump->Hmax = BIG; // No head limit
     pump->Qmax = BIG; // No flow limit
