+++ b/src/epanet.c
@@ -383,6 +383,7 @@ int DLLEXPORT EN_close(EN_Project p)
         fclose(p->outfile.HydFile);
         p->outfile.HydFile = NULL;
     }
+    closeheadfile(p);
 
     // Reset system flags
     p->Openflag = FALSE;
