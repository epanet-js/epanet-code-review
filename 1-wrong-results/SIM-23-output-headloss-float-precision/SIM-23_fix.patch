         fwrite(nsize, sizeof(INT4), 6, pr->outfile.HydFile);
+
+        // HydFile stores heads as 4-byte floats. Also keep them at full
+        // precision in a scratch file, so that head losses written to the
+        // output file are not computed from rounded heads. (If the file
+        // cannot be opened, the rounded heads are used as before.)
+        getTmpName(pr->outfile.HeadFname);
+        pr->outfile.HeadFile = fopen(pr->outfile.HeadFname, "w+b");
     }
 
     // If a previous hydraulics solution is being used, then
@@ -298,6 +307,23 @@ void closeoutfile(Project *pr)
     }
 }
 
+void closeheadfile(Project *pr)
+/*----------------------------------------------------------------
+**  Input:   none
+**  Output:  none
+**  Purpose: closes and deletes the scratch file of full-precision
+**           heads that goes with the hydraulics file.
+**----------------------------------------------------------------
+*/
+{
+    if (pr->outfile.HeadFile != NULL)
+    {
+        fclose(pr->outfile.HeadFile);
+        pr->outfile.HeadFile = NULL;
+        remove(pr->outfile.HeadFname);
+    }
+}
